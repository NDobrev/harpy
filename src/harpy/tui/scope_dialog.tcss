ScopeDialog, ScopePicker, ScopePresetName {
    layout: vertical;
    align: center middle;
    padding: 1 2;
    background: $background 70%;
}

#scope-box {
    width: 104;
    max-width: 100%;
    height: 100%;
    max-height: 38;
    background: $surface;
    border: solid $accent;
    padding: 0 1;
}

.scope-title {
    width: 1fr;
    height: auto;
    text-style: bold;
    color: $text;
}

#scope-subtitle {
    height: 1;
    color: $text-muted;
}

#scope-body {
    height: 1fr;
    min-height: 3;
    overflow-x: hidden;
    overflow-y: auto;
}

.scope-toolbar, .scope-model-row {
    width: 1fr;
    height: 3;
}

.scope-toolbar Button {
    width: auto;
    min-width: 0;
    max-width: 60%;
    margin-right: 1;
}

#scope-rows {
    height: auto;
    width: 1fr;
    overflow-x: hidden;
    overflow-y: hidden;
}

.scope-group {
    height: 1;
    margin-top: 1;
    color: $text-muted;
    text-style: bold;
}

.scope-check {
    height: auto;
    min-height: 1;
    width: 1fr;
    padding: 0 1;
}

.scope-check.-selected {
    background: $accent 25%;
    text-style: bold;
}

.scope-check.-unavailable {
    color: $text-muted;
}

#scope-model-editor {
    display: none;
    height: auto;
}

.scope-model-label {
    width: 24;
    height: 3;
    content-align: left middle;
}

.scope-model-row Button {
    width: 1fr;
    min-width: 0;
}

#scope-run-details {
    display: none;
    height: auto;
    padding: 1;
    background: $background;
}

#scope-footer {
    height: auto;
    width: 1fr;
    border-top: solid $foreground 15%;
}

#scope-focused-help {
    height: 3;
    color: $text-muted;
}

#scope-note {
    height: auto;
    color: $warning;
}

#scope-summary {
    height: auto;
    text-style: bold;
}

#scope-rerun-note {
    height: auto;
    color: $text-muted;
}

.scope-actions {
    height: 3;
    width: 1fr;
    align-horizontal: right;
}

.scope-actions Button {
    width: auto;
    min-width: 0;
    margin-left: 1;
    padding: 0 1;
}

#scope-help {
    width: 1fr;
    height: 3;
    content-align: left middle;
    color: $text-muted;
}

ScopeDialog.-compact #scope-help {
    display: none;
}

.scope-popup {
    width: 84;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    background: $surface;
    border: solid $accent;
    padding: 1;
}

#scope-picker-options {
    height: auto;
    max-height: 10;
    min-height: 2;
}

#scope-picker-detail {
    height: auto;
    max-height: 7;
    overflow-y: auto;
    margin-top: 1;
    color: $text-muted;
}

#scope-name-note {
    height: auto;
    margin-bottom: 1;
    color: $text-muted;
}
