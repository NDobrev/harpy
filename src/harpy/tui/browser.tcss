Screen {
    layout: vertical;
}

#browser-tabs {
    height: auto;
    padding: 0 1;
    text-style: bold;
}

#freshness {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#browser-rows {
    height: 1fr;
    border: solid $accent;
    overflow-y: auto;
}

#status {
    height: auto;
    min-height: 1;
    padding: 0 1;
}

.tree-row {
    width: 1fr;
    height: auto;
    text-wrap: wrap;
    padding: 0 1;
}

.tree-row.-selected {
    background: $accent;
    color: $foreground;
    text-style: bold;
}

.tree-row.tree-repo {
    color: $text-muted;
}

RepoFilterDialog {
    align: center middle;
}

#repo-filter-box {
    width: 72;
    height: auto;
    max-height: 24;
    background: $surface;
    border: solid $accent;
    padding: 1 1;
}

#repo-filter-help {
    color: $text-muted;
    padding-bottom: 1;
}

#repo-filter-rows {
    height: auto;
    max-height: 16;
    overflow-y: auto;
}
