Screen {
    layout: vertical;
}

#browser-tabs {
    height: auto;
    padding: 0 1;
    text-style: bold;
}

#freshness {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#browser-rows {
    height: 1fr;
    border: solid $accent;
    overflow-y: auto;
}

#status {
    height: auto;
    min-height: 1;
    padding: 0 1;
}

.tree-row {
    width: 1fr;
    height: auto;
    text-wrap: wrap;
    padding: 0 1;
}

.tree-row.-selected {
    background: $accent;
    color: $foreground;
    text-style: bold;
}
